{
  "expo": {
    "owner": "fra85h",
    "slug": "travelswap",
    "name": "TravelSwap",
    "scheme": "travelswap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.travelswap.app",
      "infoPlist": {
        "NSCameraUsageDescription": "TravelSwap usa la fotocamera per inquadrare il QR del biglietto e per fotografarlo da allegare all'annuncio.",
        "NSPhotoLibraryUsageDescription": "TravelSwap accede alle tue foto per allegare all'annuncio l'immagine del biglietto o della prenotazione.",
        "NSPhotoLibraryAddUsageDescription": "TravelSwap salva nelle tue foto solo le immagini che scegli di scaricare."
      }
    },
    "android": {
      "package": "com.travelswap.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C99A2E"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "travelswap" },
            { "scheme": "exp" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-barcode-scanner",
      "expo-web-browser"
    ]
  }
}
